# === ML Training — BiLSTM leakage-safe (pipeline tunggal) ===
# BERT dilatih di HPC (artifacts/bert/ + docs/bert-hpc.md), bukan repo ini.

OUTPUT_DIR=./artifacts/bilstm/output
MODEL_DIR=./artifacts/bilstm/models
CSV_INPUT=./ocr_output/data-mengandung.csv
SEED=42
CSV_DELIMITER=;
CSV_ENCODING=utf-8
TEXT_COL=text
LABEL_COL=label

# --- Kontrak split (default = final 50/50/399, 25/25) ---
V5_HOLDOUT_SIZE=50
V5_HOLDOUT_SAFE=25
V5_HOLDOUT_UNSAFE=25
V5_VAL_SAFE=25
V5_VAL_UNSAFE=25
V5_SYNTHETIC_TOTAL=1000
# WAJIB 0.5 — trainer assert, bukan tuning.
V5_FIXED_THRESHOLD=0.5
# Frozen holdout kanonis (jangan diubah setelah freeze).
V5_FROZEN_HOLDOUT_PATH=app/core/data/frozen_holdout.json
# Anti-tamper: set SHA256 kanonis daftar frozen (nama dinormalisasi
# lowercase+spasi -> sorted -> join \n -> sha256). Hitung dengan:
#   python -c "from app.core.data.frozen import load_frozen_products; print(load_frozen_products('app/core/data/frozen_holdout.json')[1])"
# Bila diset, run GAGAL bila daftar frozen berubah diam-diam
# (berlaku di trainer, bootstrap_final, dan rebuild_split).
# V5_FROZEN_SHA256=<64-hex>
V5_FROZEN_SHA256=

# --- Knob eksperimen (default = konfigurasi terbaik; override bila perlu) ---
# V5_LEARNING_RATE=1e-4
# V5_GRADIENT_CLIP_NORM=1.0
# V5_MASK_ZERO=1
# V5_W2V_MIN_COUNT=1
# V5_MAX_LEN=120
# V5_BATCH_SIZE=16
# V5_EPOCHS=20
# V5_DIGIT_FOLD=0
# V5_SHUFFLE=0
# V5_PRODUCT_COL=nama_produk
# V5_TEXT_COL=text

# --- Reproducibility (dibaca app/repro.py; JANGAN diubah untuk run resmi) ---
# PYTHONHASHSEED=42
# TF_DETERMINISTIC_OPS=1
# TF_CUDNN_DETERMINISTIC=1
# CUBLAS_WORKSPACE_CONFIG=:4096:8
# TF_ENABLE_ONEDNN_OPTS=0
