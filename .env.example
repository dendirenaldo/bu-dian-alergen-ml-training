DATASET_DIR=./dataset
OUTPUT_DIR=./output
MODEL_DIR=./models
CSV_INPUT=./ocr_output/data-mengandung.csv
SEED=42

# --- Dual-model: bilstm | lstm | bert | all ---
MODEL_TYPE=all
CSV_DELIMITER=;
CSV_ENCODING=utf-8
TEST_SIZE=0.2
VAL_SIZE=0.15
MAX_LEN=120
DEFAULT_THRESHOLD=0.5

# --- Pipeline mode: legacy | v5_parity (ikuti notebook V5 leakage-safe) ---
TRAIN_MODE=legacy
# Kontrak V5 final (Fase 4): holdout/val 50 (25/25). Split lama 23 kedaluwarsa.
V5_HOLDOUT_SIZE=50
V5_HOLDOUT_SAFE=25
V5_HOLDOUT_UNSAFE=25
V5_VAL_SAFE=25
V5_VAL_UNSAFE=25
V5_SYNTHETIC_TOTAL=1000
V5_FIXED_THRESHOLD=0.5
# Knob terbaik Fase 2-3 (default sudah terbaik; override hanya untuk eksperimen)
# V5_LEARNING_RATE=1e-4
# V5_GRADIENT_CLIP_NORM=1.0
# V5_MASK_ZERO=1
# V5_W2V_MIN_COUNT=1
# V5_MAX_LEN=120
# V5_DIGIT_FOLD=0
# V5_SHUFFLE=0
# V5_EPOCHS=20
# Path JSON daftar frozen holdout (kosongkan -> default notebook23 bila n=114,
# re-derive deterministik bila n!=114, lalu freeze hasilnya)
# V5_FROZEN_HOLDOUT_PATH=./frozen_holdout.json

# --- BERT (pluggable: ganti tanpa ubah kode) ---
BERT_MODEL_NAME=indobenchmark/indobert-base-p1
BERT_MAX_LEN=256
BERT_LR=2e-5
BERT_EPOCHS=4
BERT_BATCH_SIZE=16
BERT_WEIGHT_DECAY=0.01
BERT_WARMUP_RATIO=0.1
BERT_FREEZE_LAYERS=0
BERT_DROPOUT=0.1
BERT_NUM_TRIALS=3
